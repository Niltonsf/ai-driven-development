// Prisma models for module: cartao

model Cartao {
  id          String    @id @db.Uuid
  name        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(256)
  brand       String?   @db.VarChar(60)
  lastDigits  String?   @map("last_digits") @db.VarChar(4)
  limit       Decimal?  @db.Decimal(14, 2)
  closingDay  Int?      @map("closing_day") @db.SmallInt
  dueDay      Int?      @map("due_day") @db.SmallInt
  active      Boolean   @default(true)
  color       String?   @db.VarChar(9)
  icon        String?   @db.VarChar(60)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("cartao")
}
