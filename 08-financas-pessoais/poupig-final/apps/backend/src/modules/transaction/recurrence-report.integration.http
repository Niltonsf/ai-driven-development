GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

############################################################
# Ocorrência gravada com valor alterado
############################################################

### GET /scheduled-transactions/:rentId/32 — capturar o id efêmero do aluguel de setembro
### (espera 200 OK com "materialized": false e "occurrenceOn": "2026-09-10")
# @name rentSeptember
GET {{baseUrl}}/scheduled-transactions/{{rentId}}/32
Authorization: Bearer {{token}}

###

### PUT /scheduled-transactions/:rentId/32 — gravar o aluguel de setembro com valor 1950
### (espera 200 OK com { "id": "<id do rentSeptember>" })
PUT {{baseUrl}}/scheduled-transactions/{{rentId}}/32
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{rentSeptember.response.body.$.id}}",
  "name": "Aluguel",
  "value": 1950,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "status": "PENDING",
  "expectedOn": "2026-09-10"
}

###

### GET /reports/recurrences — setembro soma o valor gravado uma única vez (1950, e não 1950 + 1800)
### (espera 200 OK com 7 linhas; "Aluguel": "value": 1800 (valor atual da série), "total": 10950,
### months: "2026-04" a "2026-08" 1800, "2026-09" 1950; as demais linhas iguais à consulta anterior)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

############################################################
# Ocorrência gravada efetivada
############################################################

### GET /scheduled-transactions/:salaryId/31 — capturar o id efêmero do salário de agosto
### (espera 200 OK com "materialized": false e "occurrenceOn": "2026-08-05")
# @name salaryAugust
GET {{baseUrl}}/scheduled-transactions/{{salaryId}}/31
Authorization: Bearer {{token}}

###

### PUT /scheduled-transactions/:salaryId/31 — efetivar o salário de agosto com valor 5250
### (espera 200 OK com { "id": "<id do salaryAugust>" })
PUT {{baseUrl}}/scheduled-transactions/{{salaryId}}/31
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{salaryAugust.response.body.$.id}}",
  "name": "Salario",
  "value": 5250,
  "direction": "IN",
  "accountId": "{{accountId}}",
  "status": "SETTLED",
  "expectedOn": "2026-08-05",
  "settledOn": "2026-08-05"
}

###

### GET /reports/recurrences — a efetivada entra com o valor gravado
### (espera 200 OK com 7 linhas; "Salario": "total": 30250,
### months: "2026-04" a "2026-07" 5000, "2026-08" 5250, "2026-09" 5000; as demais iguais à consulta anterior)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

