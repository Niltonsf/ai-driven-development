@baseUrl = http://localhost:4000
@password = #Senha123

# Roteiro executável em ordem (Rest Client). Cada execução registra dois usuários novos
# (e-mails com {{$guid}}), então os valores abaixo valem para uma execução completa.
# GET /reports/recurrences?reference=YYYY-MM&months=N devolve um array JSON, sem paginação e sem envelope,
# com uma linha por recorrência (série "OPEN" não excluída):
# [{ "seriesId": "<uuid>", "name": "...", "direction": "IN"|"OUT", "value": 0, "recurrence": { "unit": ... },
#    "accountName": "...", "creditCardName": null, "categoryName": null, "subcategoryName": null,
#    "startDate": "YYYY-MM-DD", "endDate": "YYYY-MM-DD"|null, "total": 0,
#    "months": [{ "month": "YYYY-MM", "total": 0 }, ...] }, ...]
# "months" tem exatamente N itens em ordem crescente terminando no mês de referência, com 0 no mês sem ocorrência.
# Cada mês soma, pela data prevista: ocorrências gravadas pendentes e efetivadas (sem canceladas) e ocorrências
# geradas ainda não gravadas, com o valor atual da série. Parcelamentos ("CLOSED") e avulsas não entram.
# Toda recorrência vigente na janela aparece, mesmo zerada. Ordem: "IN" antes de "OUT" e, na direção, por nome.
# "value" é o valor atual da série; os valores são números positivos com até duas casas.
# Erros seguem o formato do ApiExceptionFilter:
# { "statusCode": 400|401, "error": "...", "message": ["CODIGO", ...], "path": "...", "timestamp": "..." }
#
# Índices usados (séries mensais iniciadas em 2024-01-01, índice 0 em janeiro de 2024):
# 2026-07 = índice 30, 2026-08 = índice 31, 2026-09 = índice 32.

############################################################
# Preparação — usuário A (dono do relatório)
############################################################

### POST /auth/register — registrar o usuário A (espera 201 Created)
# @name registerA
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Usuario Recorrencias",
  "email": "recorrencias.{{$guid}}@poupig.test",
  "password": "{{password}}"
}

###

### POST /auth/login — autenticar o usuário A (espera 200 OK com token)
# @name loginA
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registerA.response.body.$.email}}",
  "password": "{{password}}"
}

###

@token = {{loginA.response.body.$.token}}

### POST /accounts — criar a conta do usuário A (espera 201 Created)
POST {{baseUrl}}/accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Conta Corrente",
  "type": "CHECKING"
}

###

### GET /accounts — capturar o id da conta do usuário A (espera 200 OK)
# @name accountsA
GET {{baseUrl}}/accounts
Authorization: Bearer {{token}}

###

@accountId = {{accountsA.response.body.$.items[0].id}}

############################################################
# Preparação — usuário B (tem recorrência na mesma janela)
############################################################

### POST /auth/register — registrar o usuário B (espera 201 Created)
# @name registerB
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Outro Usuario",
  "email": "outro.recorrencias.{{$guid}}@poupig.test",
  "password": "{{password}}"
}

###

### POST /auth/login — autenticar o usuário B (espera 200 OK)
# @name loginB
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registerB.response.body.$.email}}",
  "password": "{{password}}"
}

###

@tokenB = {{loginB.response.body.$.token}}

### POST /accounts — criar a conta do usuário B (espera 201 Created)
POST {{baseUrl}}/accounts
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "name": "Conta do Outro",
  "type": "CASH"
}

###

### GET /accounts — capturar o id da conta do usuário B (espera 200 OK)
# @name accountsB
GET {{baseUrl}}/accounts
Authorization: Bearer {{tokenB}}

###

@otherAccountId = {{accountsB.response.body.$.items[0].id}}

### POST /transaction-series — recorrência mensal do usuário B, no dia 10, início 2026-01-01
### (espera 201 Created com { "id": "<uuid>" })
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "name": "Assinatura do Outro",
  "value": 555,
  "direction": "OUT",
  "accountId": "{{otherAccountId}}",
  "kind": "OPEN",
  "unit": "MONTH",
  "interval": 1,
  "dayOfMonth": 10,
  "startDate": "2026-01-01"
}

###

############################################################
# Usuário sem recorrência
############################################################

### GET /reports/recurrences — usuário A recém-registrado, sem nenhuma série
### (espera 200 OK com [] — a recorrência do usuário B não vaza)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=12
Authorization: Bearer {{token}}

###

############################################################
# Recorrências mensais criadas sem nada gravado
############################################################

### POST /transaction-series — entrada mensal "Salario", dia 5, início 2024-01-01, sem fim
### (espera 201 Created com { "id": "<uuid>" })
# @name createSalary
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Salario",
  "value": 5000,
  "direction": "IN",
  "accountId": "{{accountId}}",
  "kind": "OPEN",
  "unit": "MONTH",
  "interval": 1,
  "dayOfMonth": 5,
  "startDate": "2024-01-01"
}

###

@salaryId = {{createSalary.response.body.$.id}}

### POST /transaction-series — saída mensal "Internet", dia 15, início 2024-01-01, sem fim
### (criada antes de "Aluguel" para mostrar que a ordem é por nome, e não por criação)
### (espera 201 Created com { "id": "<uuid>" })
# @name createInternet
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Internet",
  "value": 119.9,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "kind": "OPEN",
  "unit": "MONTH",
  "interval": 1,
  "dayOfMonth": 15,
  "startDate": "2024-01-01"
}

###

@internetId = {{createInternet.response.body.$.id}}

### POST /transaction-series — saída mensal "Aluguel", dia 10, início 2024-01-01, sem fim
### (espera 201 Created com { "id": "<uuid>" })
# @name createRent
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Aluguel",
  "value": 1800,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "kind": "OPEN",
  "unit": "MONTH",
  "interval": 1,
  "dayOfMonth": 10,
  "startDate": "2024-01-01"
}

###

@rentId = {{createRent.response.body.$.id}}

### GET /reports/recurrences — janela de 6 meses: cada mês soma o valor da série sem nada gravado
### (espera 200 OK com 3 linhas, a entrada primeiro e as saídas por nome:
### [0] { "seriesId": "<salaryId>", "name": "Salario", "direction": "IN", "value": 5000,
###       "recurrence": { "unit": "MONTH", "interval": 1, "dayOfMonth": 5 }, "accountName": "Conta Corrente",
###       "creditCardName": null, "categoryName": null, "subcategoryName": null,
###       "startDate": "2024-01-01", "endDate": null, "total": 30000,
###       "months": 6 itens de "2026-04" a "2026-09", todos com "total": 5000 }
### [1] { "seriesId": "<rentId>", "name": "Aluguel", "direction": "OUT", "value": 1800,
###       "recurrence": { "unit": "MONTH", "interval": 1, "dayOfMonth": 10 }, "total": 10800,
###       "months": 6 itens de "2026-04" a "2026-09", todos com "total": 1800 }
### [2] { "seriesId": "<internetId>", "name": "Internet", "direction": "OUT", "value": 119.9,
###       "recurrence": { "unit": "MONTH", "interval": 1, "dayOfMonth": 15 }, "total": 719.4,
###       "months": 6 itens de "2026-04" a "2026-09", todos com "total": 119.9 }
### nenhuma linha traz "userId", "accountId", "kind", "installments" ou datas de auditoria)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

### GET /reports/recurrences — janela de 24 meses
### (espera 200 OK com as mesmas 3 linhas na mesma ordem, cada uma com 24 meses de "2024-10" a "2026-09":
### [0] "Salario"  "total": 120000, todos os meses 5000;
### [1] "Aluguel"  "total": 43200, todos os meses 1800;
### [2] "Internet" "total": 2877.6, todos os meses 119.9;
### "months"[0].month = "2024-10" e "months"[23].month = "2026-09")
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=24
Authorization: Bearer {{token}}

###

############################################################
# Recorrência semanal e recorrência anual fora da janela
############################################################

### POST /transaction-series — saída semanal "Feira", aos sábados (weekDay 6), início 2026-01-01, sem fim.
### Sábados: 2026-04 = 4, 2026-05 = 5, 2026-06 = 4, 2026-07 = 4, 2026-08 = 5 (1, 8, 15, 22, 29),
### 2026-09 = 4 (5, 12, 19, 26) (espera 201 Created com { "id": "<uuid>" })
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Feira",
  "value": 50,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "kind": "OPEN",
  "unit": "WEEK",
  "interval": 1,
  "weekDay": 6,
  "startDate": "2026-01-01"
}

###

### POST /transaction-series — saída anual "Seguro do carro", 20 de novembro, início 2025-01-01, sem fim.
### Ocorrências: 2025-11-20, 2026-11-20 — nenhuma entre 2026-04 e 2026-09
### (espera 201 Created com { "id": "<uuid>" })
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Seguro do carro",
  "value": 2400,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "kind": "OPEN",
  "unit": "YEAR",
  "interval": 1,
  "month": 11,
  "dayOfMonth": 20,
  "startDate": "2025-01-01"
}

###

### GET /reports/recurrences — a semanal soma 4 ou 5 ocorrências por mês e a anual aparece zerada
### (espera 200 OK com 5 linhas: "Salario", "Aluguel", "Feira", "Internet", "Seguro do carro";
### "Salario", "Aluguel" e "Internet" iguais à consulta de 6 meses acima;
### "Feira": "recurrence": { "unit": "WEEK", "interval": 1, "weekDay": 6 }, "value": 50, "total": 1300,
###   months: "2026-04" 200, "2026-05" 250, "2026-06" 200, "2026-07" 200, "2026-08" 250, "2026-09" 200;
### "Seguro do carro": "recurrence": { "unit": "YEAR", "interval": 1, "month": 11, "dayOfMonth": 20 },
###   "value": 2400, "total": 0, os 6 meses com "total": 0)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

############################################################
# Parcelamento e transação avulsa ficam fora
############################################################

### POST /transaction-series — parcelamento "Celular parcelado", 10x no dia 20, início 2026-05-01.
### Parcelas de 2026-05-20 a 2027-02-20 (espera 201 Created com { "id": "<uuid>" })
POST {{baseUrl}}/transaction-series
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Celular parcelado",
  "value": 250.5,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "kind": "CLOSED",
  "unit": "MONTH",
  "interval": 1,
  "dayOfMonth": 20,
  "startDate": "2026-05-01",
  "installments": 10
}

###

### POST /transactions — saída avulsa "Mercado" em setembro (espera 201 Created)
POST {{baseUrl}}/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Mercado",
  "value": 300,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "expectedOn": "2026-09-12"
}

###

### GET /reports/recurrences — nada muda
### (espera 200 OK com as mesmas 5 linhas e os mesmos valores da consulta anterior;
### nenhuma linha "Celular parcelado" e nenhum mês somando 250.5 ou 300)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

