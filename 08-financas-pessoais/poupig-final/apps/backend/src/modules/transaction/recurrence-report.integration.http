### (espera 200 OK com 7 linhas: "Salario", "Academia", "Aluguel", "Feira", "Internet", "Seguro do carro",
### "Streaming"; as já existentes iguais à consulta anterior;
### "Academia": "startDate": "2024-01-01", "endDate": "2026-06-30", "total": 299.7,
###   months: "2026-04" 99.9, "2026-05" 99.9, "2026-06" 99.9, "2026-07" 0, "2026-08" 0, "2026-09" 0;
