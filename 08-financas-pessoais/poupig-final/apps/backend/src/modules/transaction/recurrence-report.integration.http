############################################################
# Ocorrência revertida volta a ser gerada
############################################################

### DELETE /scheduled-transactions/:rentId/32 — reverter o aluguel de setembro (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/scheduled-transactions/{{rentId}}/32
Authorization: Bearer {{token}}

###

### GET /reports/recurrences — setembro volta a somar o valor da série
### (espera 200 OK com 7 linhas, nesta ordem e com estes valores de "2026-04" a "2026-09":
### [0] "Salario"         IN  "total": 30250  months: 5000, 5000, 5000, 5000, 5250, 5000
### [1] "Academia"        OUT "total": 299.7  months: 99.9, 99.9, 99.9, 0, 0, 0
### [2] "Aluguel"         OUT "total": 10800  months: 1800, 1800, 1800, 1800, 1800, 1800
### [3] "Feira"           OUT "total": 1300   months: 200, 250, 200, 200, 250, 200
### [4] "Internet"        OUT "total": 599.5  months: 119.9, 119.9, 119.9, 0, 0, 239.8
### [5] "Seguro do carro" OUT "total": 0      months: 0, 0, 0, 0, 0, 0
### [6] "Streaming"       OUT "total": 119.7  months: 0, 0, 0, 39.9, 39.9, 39.9)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

############################################################
# Comparação com o extrato
############################################################

### GET /statement — setembro
### (espera 200 OK com "meta.total": 11:
### séries "OPEN" não canceladas: "Salario" IN 5000 (09-05); "Aluguel" OUT 1800 (09-10);
###   "Internet" OUT 119.9 "occurrenceIndex": 32 (09-15) e OUT 119.9 "occurrenceIndex": 31 (09-30, movida);
###   "Feira" OUT 50 em 09-05, 09-12, 09-19 e 09-26; "Streaming" OUT 39.9 (09-20);
### fora do relatório: "Celular parcelado" ("seriesKind": "CLOSED", 250.5, 09-20) e "Mercado" ("kind": "TRANSACTION").
### Somando só as séries "OPEN" não canceladas: entradas 5000 e saídas 2279.7 (1800 + 239.8 + 200 + 39.9) —
### iguais à soma de "2026-09" no relatório acima: IN 5000; OUT 0 + 1800 + 200 + 239.8 + 0 + 39.9 = 2279.7)
GET {{baseUrl}}/statement?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

### GET /statement — julho
### (espera 200 OK com "meta.total": 9:
### séries "OPEN": "Salario" IN 5000; "Aluguel" OUT 1800; "Feira" OUT 50 em 07-04, 07-11, 07-18 e 07-25;
###   "Streaming" OUT 39.9; "Internet" OUT 119.9 com "status": "CANCELED" (não soma);
### fora do relatório: "Celular parcelado" ("seriesKind": "CLOSED", 250.5, 07-20).
### Somando só as séries "OPEN" não canceladas: entradas 5000 e saídas 2039.9 (1800 + 200 + 39.9) —
### iguais à soma de "2026-07" no relatório acima: IN 5000; OUT 0 + 1800 + 200 + 0 + 0 + 39.9 = 2039.9)
GET {{baseUrl}}/statement?from=2026-07-01&to=2026-07-31
Authorization: Bearer {{token}}

###

############################################################
# Ocorrência movida para o primeiro dia do mês seguinte
############################################################

### GET /scheduled-transactions/:salaryId/32 — capturar o id efêmero do salário de setembro
### (espera 200 OK com "materialized": false e "occurrenceOn": "2026-09-05")
# @name salarySeptember
GET {{baseUrl}}/scheduled-transactions/{{salaryId}}/32
Authorization: Bearer {{token}}

###

### PUT /scheduled-transactions/:salaryId/32 — mover de 2026-09-05 para 2026-10-01
### (espera 200 OK com { "id": "<id do salarySeptember>" })
PUT {{baseUrl}}/scheduled-transactions/{{salaryId}}/32
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{salarySeptember.response.body.$.id}}",
  "name": "Salario",
  "value": 5000,
  "direction": "IN",
  "accountId": "{{accountId}}",
  "expectedOn": "2026-10-01"
}

###

### GET /reports/recurrences — referência 2026-09: a movida saiu da janela e não é regerada em setembro
### (espera 200 OK com 7 linhas; "Salario": "total": 25250,
### months: "2026-04" a "2026-07" 5000, "2026-08" 5250, "2026-09" 0)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

### GET /reports/recurrences — referência 2026-10: a movida cai em outubro, e não em setembro
### (espera 200 OK com 7 linhas e 6 meses de "2026-05" a "2026-10"; "Salario": "total": 30250,
### months: "2026-05" 5000, "2026-06" 5000, "2026-07" 5000, "2026-08" 5250, "2026-09" 0,
### "2026-10" 10000 — a movida (5000) mais a de outubro gerada (5000))
GET {{baseUrl}}/reports/recurrences?reference=2026-10&months=6
Authorization: Bearer {{token}}

###

### DELETE /scheduled-transactions/:salaryId/32 — reverter o salário de setembro (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/scheduled-transactions/{{salaryId}}/32
Authorization: Bearer {{token}}

###

############################################################
# Série excluída
############################################################

### DELETE /transaction-series/:internetId — exclusão lógica da "Internet", que tem ocorrências gravadas
### (a cancelada de julho e a movida para 2026-09-30) (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/transaction-series/{{internetId}}
Authorization: Bearer {{token}}

###

### GET /reports/recurrences — nem as gravadas nem as geradas da série excluída entram
### (espera 200 OK com 6 linhas: "Salario", "Academia", "Aluguel", "Feira", "Seguro do carro", "Streaming";
### nenhuma linha "Internet"; "Salario" de volta a "total": 30250 com "2026-09" 5000;
### as demais iguais à consulta depois da reversão do aluguel)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

############################################################
# Dados de outro usuário
############################################################

### GET /reports/recurrences — o relatório de A não traz a recorrência do usuário B
### (espera 200 OK com as mesmas 6 linhas da consulta anterior; nenhuma "Assinatura do Outro" e nenhum mês com 555)
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{token}}

###

### GET /reports/recurrences — o relatório de B só enxerga a recorrência de B
### (espera 200 OK com 1 linha: { "name": "Assinatura do Outro", "direction": "OUT", "value": 555,
### "accountName": "Conta do Outro", "startDate": "2026-01-01", "endDate": null, "total": 3330,
### "months": 6 itens de "2026-04" a "2026-09", todos com "total": 555 })
GET {{baseUrl}}/reports/recurrences?reference=2026-09&months=6
Authorization: Bearer {{tokenB}}

###

