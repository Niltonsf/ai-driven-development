  "name": "Moradia",
  "icon": "home",
  "color": "#4A90D9",
  "subcategories": [
    { "name": "Aluguel", "icon": "building", "color": "#4A90D9", "order": 1 },
    { "name": "Energia", "icon": "zap", "color": "#4A90D9", "order": 2 }
  ]
}

