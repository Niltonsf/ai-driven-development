############################################################
# Mês com gastos
############################################################

### GET /reports/categories — setembro de 2026
### "Aluguel" de 2026-09-30 entra; "Mercado de outubro" (2026-10-01), "Pizza cancelada", "Lanche excluido",
### "Salario" (entrada) e "Aluguel recebido" (série de entrada) não; "Energia" soma a avulsa (15.25) com a
### ocorrência gerada da série (210.5); "Restaurantes" soma a avulsa (89.9) com as 4 sextas geradas (4 x 45.5);
### "Farmácia" e "Transporte / Combustível" não aparecem; nada do usuário B aparece.
### (espera 200 OK com 8 itens, nesta ordem:
### [0] { "categoryId": "<id de Moradia>", "categoryName": "Moradia", "categoryColor": "#4A90D9",
###       "categoryIcon": "home", "subcategoryId": "<rentId>", "subcategoryName": "Aluguel",
###       "subcategoryColor": "#4A90D9", "subcategoryIcon": "building", "total": 1800 };
### [1] { "categoryName": "Alimentação", "categoryColor": "#F5A623", "categoryIcon": "utensils",
###       "subcategoryId": "<groceryId>", "subcategoryName": "Supermercado", "subcategoryColor": "#F5A623",
###       "subcategoryIcon": "shopping-cart", "total": 770.75 };
### [2] { "categoryName": "Alimentação", "subcategoryName": "Restaurantes", "subcategoryIcon": "utensils-crossed",
###       "total": 271.9 };
### [3] { "categoryName": "Moradia", "subcategoryName": "Energia", "subcategoryIcon": "zap", "total": 225.75 };
### [4] { "categoryName": "Educação", "categoryColor": "#1ABC9C", "subcategoryName": "Cursos", "total": 199.9 };
### [5] { "categoryName": "Saúde", "categoryColor": "#E74C3C", "subcategoryName": "Academia", "total": 110 };
### [6] { "categoryName": "Lazer", "categoryColor": "#9B59B6", "subcategoryName": "Cinema", "total": 40 };
### [7] { "categoryId": null, "categoryName": null, "categoryColor": null, "categoryIcon": null,
###       "subcategoryId": null, "subcategoryName": null, "subcategoryColor": null, "subcategoryIcon": null,
###       "total": 33.33 }
### — soma dos "total": 3451.63)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

### GET /statement — setembro de 2026, para comparar com o relatório acima
### (espera 200 OK com "meta.total": 17: 11 avulsas ("Lanche excluido" e "Mercado de outubro" ficam fora),
### a ocorrência gerada de "Conta de luz", a de "Aluguel recebido" e as 4 de "Almoco de sexta".
### Somando as entradas "direction": "OUT" sem "status": "CANCELED": 1800 + 650.4 + 120.35 + 89.9 + 15.25
### + 40 + 199.9 + 110 + 33.33 + 210.5 + 4 x 45.5 = 3451.63 — igual à soma dos "total" do relatório)
GET {{baseUrl}}/statement?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

############################################################
# Ocorrência gravada soma uma vez
############################################################

### GET /scheduled-transactions/:seriesId/0 — capturar o id efêmero da ocorrência de setembro de "Conta de luz"
### (espera 200 OK com "materialized": false e "occurrenceOn": "2026-09-15")
# @name energyOccurrence0
GET {{baseUrl}}/scheduled-transactions/{{energySeriesId}}/0
Authorization: Bearer {{token}}

###

@energyOccurrence0Id = {{energyOccurrence0.response.body.$.id}}

### PUT /scheduled-transactions/:seriesId/0 — gravar a ocorrência com valor 250
### (espera 200 OK com { "id": "<energyOccurrence0Id>" })
PUT {{baseUrl}}/scheduled-transactions/{{energySeriesId}}/0
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{energyOccurrence0Id}}",
  "name": "Conta de luz",
  "value": 250,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "subcategoryId": "{{energyId}}",
  "status": "PENDING",
  "expectedOn": "2026-09-15"
}

###

### GET /reports/categories — "Energia" soma o valor gravado uma única vez (15.25 + 250, e não + 210.5)
### (espera 200 OK com 8 itens: [0] "Aluguel": 1800; [1] "Supermercado": 770.75; [2] "Restaurantes": 271.9;
### [3] "Energia": 265.25; [4] "Cursos": 199.9; [5] "Academia": 110; [6] "Cinema": 40;
### [7] (sem classificação): 33.33)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

