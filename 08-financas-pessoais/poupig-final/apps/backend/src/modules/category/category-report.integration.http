### GET /categories — capturar categorias e subcategorias do usuário A
### (espera 200 OK com 6 categorias na ordem de criação: [0] "Moradia", [1] "Alimentação", [2] "Lazer",
### [3] "Educação", [4] "Saúde", [5] "Transporte"; subcategorias pela "order")
# @name categoriesA
GET {{baseUrl}}/categories
Authorization: Bearer {{token}}

###

@rentId = {{categoriesA.response.body.$[0].subcategories[0].id}}
@energyId = {{categoriesA.response.body.$[0].subcategories[1].id}}
@groceryId = {{categoriesA.response.body.$[1].subcategories[0].id}}
@restaurantId = {{categoriesA.response.body.$[1].subcategories[1].id}}
@leisureCategoryId = {{categoriesA.response.body.$[2].id}}
@cinemaId = {{categoriesA.response.body.$[2].subcategories[0].id}}
@educationCategoryId = {{categoriesA.response.body.$[3].id}}
@coursesId = {{categoriesA.response.body.$[3].subcategories[0].id}}
@healthCategoryId = {{categoriesA.response.body.$[4].id}}
@pharmacyId = {{categoriesA.response.body.$[4].subcategories[0].id}}
@gymId = {{categoriesA.response.body.$[4].subcategories[1].id}}

