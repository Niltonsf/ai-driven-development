###

### GET /statement — setembro de novo
### (espera 200 OK com "meta.total": 17; a ocorrência "occurrenceIndex": 0 de "Conta de luz" vem gravada com
### "status": "CANCELED" e "value": 250, sem outra entrada gerada para o mesmo índice. Somando as saídas
### não canceladas: 3241.13 — igual à soma dos "total" do relatório acima)
GET {{baseUrl}}/statement?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

############################################################
# Ocorrência revertida volta a ser gerada
############################################################

### DELETE /scheduled-transactions/:seriesId/0 — reverter a ocorrência (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/scheduled-transactions/{{energySeriesId}}/0
Authorization: Bearer {{token}}

###

### GET /reports/categories — "Energia" volta a somar a ocorrência gerada (15.25 + 210.5)
### (espera 200 OK com os mesmos 8 itens da primeira consulta de setembro: [0] "Aluguel": 1800;
### [1] "Supermercado": 770.75; [2] "Restaurantes": 271.9; [3] "Energia": 225.75; [4] "Cursos": 199.9;
### [5] "Academia": 110; [6] "Cinema": 40; [7] (sem classificação): 33.33)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

############################################################
# Série excluída
############################################################

### GET /scheduled-transactions/:seriesId/1 — capturar o id efêmero da 2ª sexta de "Almoco de sexta"
### (espera 200 OK com "materialized": false e "occurrenceOn": "2026-09-11")
# @name lunchOccurrence1
GET {{baseUrl}}/scheduled-transactions/{{lunchSeriesId}}/1
Authorization: Bearer {{token}}

###

### PUT /scheduled-transactions/:seriesId/1 — gravar a 2ª sexta efetivada com valor 50
### (espera 200 OK com { "id": "<id do lunchOccurrence1>" })
PUT {{baseUrl}}/scheduled-transactions/{{lunchSeriesId}}/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{lunchOccurrence1.response.body.$.id}}",
  "name": "Almoco de sexta",
  "value": 50,
  "direction": "OUT",
  "accountId": "{{accountId}}",
  "subcategoryId": "{{restaurantId}}",
  "status": "SETTLED",
  "expectedOn": "2026-09-11",
  "settledOn": "2026-09-11"
}

###

### GET /reports/categories — "Restaurantes" soma a avulsa, 3 sextas geradas e a gravada (89.9 + 3 x 45.5 + 50)
### (espera 200 OK com 8 itens; [2] "Restaurantes": 276.4; os demais iguais à consulta anterior)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

### DELETE /transaction-series/:id — exclusão lógica de "Almoco de sexta" (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/transaction-series/{{lunchSeriesId}}
Authorization: Bearer {{token}}

###

### GET /reports/categories — nem a sexta gravada nem as geradas entram: "Restaurantes" fica só com a avulsa
### (espera 200 OK com 8 itens: [0] "Aluguel": 1800; [1] "Supermercado": 770.75; [2] "Energia": 225.75;
### [3] "Cursos": 199.9; [4] "Academia": 110; [5] "Restaurantes": 89.9; [6] "Cinema": 40;
### [7] (sem classificação): 33.33 — soma dos "total": 3269.63)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

###

############################################################
# Categoria inativa, categoria excluída e subcategoria removida no formulário
############################################################

### PUT /categories/:id — inativar "Lazer", mantendo a subcategoria "Cinema" (espera 200 OK com { "success": true })
PUT {{baseUrl}}/categories/{{leisureCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Lazer",
  "icon": "gamepad-2",
  "color": "#9B59B6",
  "isActive": false,
  "subcategories": [
    { "id": "{{cinemaId}}", "name": "Cinema", "icon": "clapperboard", "color": "#9B59B6", "order": 1 }
  ]
}

###

### DELETE /categories/:id — excluir logicamente "Educação" e a subcategoria "Cursos"
### (espera 200 OK com { "success": true })
DELETE {{baseUrl}}/categories/{{educationCategoryId}}
Authorization: Bearer {{token}}

###

### PUT /categories/:id — "Saúde" sem "Academia": a subcategoria é apagada e a transação dela fica sem subcategoria
### (espera 200 OK com { "success": true })
PUT {{baseUrl}}/categories/{{healthCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Saúde",
  "icon": "heart-pulse",
  "color": "#E74C3C",
  "subcategories": [
    { "id": "{{pharmacyId}}", "name": "Farmácia", "icon": "pill", "color": "#E74C3C", "order": 1 }
  ]
}

###

### GET /reports/categories — "Cinema" (categoria inativa) e "Cursos" (categoria excluída) continuam com os nomes;
### os 110 de "Academia" passam para o item sem classificação (33.33 + 110); "Saúde" (só "Farmácia", sem gasto)
### e "Transporte" não aparecem
### (espera 200 OK com 7 itens: [0] "Moradia / Aluguel": 1800; [1] "Alimentação / Supermercado": 770.75;
### [2] "Moradia / Energia": 225.75;
### [3] { "categoryId": "<educationCategoryId>", "categoryName": "Educação", "categoryColor": "#1ABC9C",
###       "categoryIcon": "graduation-cap", "subcategoryId": "<coursesId>", "subcategoryName": "Cursos",
###       "subcategoryColor": "#1ABC9C", "subcategoryIcon": "book-open", "total": 199.9 };
### [4] (sem classificação): 143.33; [5] "Alimentação / Restaurantes": 89.9;
### [6] { "categoryId": "<leisureCategoryId>", "categoryName": "Lazer", "categoryColor": "#9B59B6",
###       "categoryIcon": "gamepad-2", "subcategoryId": "<cinemaId>", "subcategoryName": "Cinema",
###       "subcategoryColor": "#9B59B6", "subcategoryIcon": "clapperboard", "total": 40 }
### — soma dos "total": 3269.63, a mesma de antes: nada some do relatório)
GET {{baseUrl}}/reports/categories?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}

