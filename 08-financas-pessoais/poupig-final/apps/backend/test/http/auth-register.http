@baseUrl = http://localhost:4000

### Register a new user (expects 201 Created)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Teste Integracao",
  "email": "teste.integracao@poupig.test",
  "password": "#Senha123"
}

### Register the SAME email again (expects 409 Conflict - email already in use)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Teste Integracao",
  "email": "teste.integracao@poupig.test",
  "password": "#Senha123"
}

### Register with a weak password (expects 400 Bad Request - validation error)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Teste Fraco",
  "email": "teste.fraco@poupig.test",
  "password": "123"
}
