DATABASE_URL="postgresql://poupig:poupig@localhost:5432/poupig?schema=public"
PORT="4000"
JWT_SECRET="YOUR_SECRET_HERE"

# Development tools (data generator at /dev/data-generator). Only the exact value "true" turns them on.
# Production never defines this variable, so the routes answer 404 there.
DEV_TOOLS_ENABLED="true"
