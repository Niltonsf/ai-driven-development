
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# Liga o menu "Extras › Desenvolvimento" e a tela /dev (gerador de massa de dados).
# O valor é embutido no build: altere e reinicie o `next dev` ou refaça o build.
# Produção não define esta variável, então o recurso fica desligado.
NEXT_PUBLIC_DEV_TOOLS_ENABLED=true
