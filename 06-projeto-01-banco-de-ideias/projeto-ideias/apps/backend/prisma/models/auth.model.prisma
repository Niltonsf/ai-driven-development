model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ideaTypes   IdeaType[]
  ideas       Idea[]
  processings Processing[]

  @@map("auth_user")
}
