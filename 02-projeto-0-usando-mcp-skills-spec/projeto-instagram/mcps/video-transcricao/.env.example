# Chave da API da OpenAI usada pelo MCP de transcrição de vídeo.
# Copie este arquivo para .env (nesta mesma pasta) e preencha com a sua chave real.
OPENAI_API_KEY=sk-sua-chave-aqui

# (Opcional) Modelo de transcrição. Padrão: whisper-1.
# Outras opções: gpt-4o-transcribe, gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# (Opcional) Sufixo do arquivo de saída: <nome do video><sufixo>.txt
# Padrão: .transcricao  ->  video.mp4 gera video.transcricao.txt
# TRANSCRIPTION_SUFFIX=.transcricao
