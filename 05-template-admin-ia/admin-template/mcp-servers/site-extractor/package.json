{
  "name": "mcp-site-extractor",
  "version": "1.0.0",
  "description": "MCP server para extrair páginas web (HTML, CSS, JS, imagens, fontes) usando Playwright. Suporta Claude Code, Codex, Cursor e qualquer cliente MCP via stdio.",
  "type": "commonjs",
  "main": "src/mcp-server.mjs",
  "bin": {
    "mcp-site-extractor": "src/mcp-server.mjs"
  },
  "files": [
    "src",
    "README.md",
    ".mcp.json"
  ],
  "scripts": {
    "start": "node src/mcp-server.mjs",
    "mcp": "node src/mcp-server.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "entities": "^6.0.1",
    "mime-types": "^3.0.2",
    "playwright": "^1.52.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "site-extractor",
    "playwright",
    "scraping",
    "claude",
    "codex"
  ],
  "author": "",
  "license": "ISC"
}
